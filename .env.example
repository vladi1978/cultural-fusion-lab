# Cultural Fusion Lab — server environment template
# Copy to .env.local for local development. Never commit real secrets.

# Required only for future live Qloo integration (not used by Demo Mode).
# Keep this on the server only — never expose to the client or commit real values.
QLOO_API_KEY=

# Optional. Defaults to the hackathon API host when unset.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Explicit opt-in for Live Mode. Leave false/unset until a real key authenticates.
# Live Mode also requires a successful server-side auth probe in-process.
QLOO_LIVE_ENABLED=false

# Optional request timeout for Qloo HTTP calls (milliseconds).
QLOO_REQUEST_TIMEOUT_MS=12000

# Live creative generation (optional; costs money). Server only.
ANTHROPIC_API_KEY=
CFL_CREATIVE_LLM_ENABLED=false
# Hard spend cap in USD (default 5) and per-million-token prices used for the estimate.
CFL_CREATIVE_TOTAL_CAP_USD=5
CFL_CREATIVE_PRICE_IN_USD_PER_MTOK=
CFL_CREATIVE_PRICE_OUT_USD_PER_MTOK=
# Shared validation budget: set true to cap Qloo/model calls across one validation session.
CFL_VALIDATION_SESSION=false
