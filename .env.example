# Cultural Fusion Lab — server environment template
# Copy to .env.local for local development. Never commit real secrets.

# Required only for future live Qloo integration (not used by Demo Mode).
# Keep this on the server only — never expose to the client.
QLOO_API_KEY=

# Optional. Defaults to the hackathon API host when unset.
QLOO_BASE_URL=https://hackathon.api.qloo.com
